# kishizu show configuration — EXAMPLE.
#
# Copy to shows.yaml and edit. shows.yaml is gitignored: it is your watch
# list, and publishing it tells the internet what you watch and where you
# are in each season.
#
# Fields:
#   name     - your own name for the show. Becomes the canonical name.
#   aliases  - every other title it is known by. Include the romaji title
#              used by animeschedule.net and by release groups, and any
#              native title (Korean webtoon adaptations are listed under
#              their Korean name, e.g. Tomb Raider King airs as "Dogul Wang").
#   watched  - how many episodes you have already seen. Episodes 1..watched
#              are latched as watched, so they are never grabbed.
#   max      - total episodes in the season. 0 = unknown, no upper bound.
#
# Apply with: kishizu -db kishizu.db -config shows.yaml -seed
#
# In practice you will add shows from the web UI by pasting an
# animeschedule.net URL, which fills in the aliases and max for you. This
# file is for seeding a fresh database in one go.

shows:
  - name: Example Show
    aliases:
      - Example Show Romaji Title
    watched: 0
    max: 12
